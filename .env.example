# 로컬에서 테스트할 때 쓰는 예시. 실제 값이 든 .env 는 커밋하지 않는다.

# ── 카카오 (필수) ─────────────────────────────────────────────
KAKAO_REST_API_KEY=카카오_개발자_콘솔의_REST_API_키
KAKAO_REFRESH_TOKEN=scripts/kakao_authorize.py 로_발급받은_값
# 카카오 콘솔에서 Client Secret 을 켰을 때만 필요
KAKAO_CLIENT_SECRET=

# ── 캘린더: 방법 A. 비공개 iCal 주소 (가장 간단, OAuth 불필요) ──
# 구글 캘린더 설정 > 캘린더 통합 > "iCal 형식의 비공개 주소"
# 여러 개면 쉼표로 구분
GOOGLE_CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/.../private-.../basic.ics

# ── 캘린더: 방법 B. Google Calendar API (OAuth) ───────────────
# 아래 세 값이 모두 있으면 방법 B 가 자동 선택된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 조회할 캘린더 (기본값 primary). 쉼표로 여러 개
GOOGLE_CALENDAR_IDS=primary

# ── 공통 옵션 ────────────────────────────────────────────────
TIMEZONE=Asia/Seoul
# ics | google (비우면 위 값에 맞춰 자동 판단)
CALENDAR_SOURCE=
# 내가 '참석 거절'한 일정 제외 (방법 B 에서만 적용)
SKIP_DECLINED=true
# 1 이면 카카오톡으로 보내지 않고 화면에만 출력
DRY_RUN=
